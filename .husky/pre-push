. "$(dirname "$0")/h"
. "$(dirname "$0")/utils"

print_header "Pre-push verification  ୧༼ಠ益ຠ༽୨" "$BLUE"
check_all_tools

# Backend fixes
print_stage "Rust backend"
run_check "Running cargo fix..." "pnpm run fix:backend" "Fixes applied" "Cargo fix failed"

echo ""

# Build & test
print_stage "Full build & test"
run_check "Building..." "pnpm run build" "Build successful" "Build failed"
run_check "Running tests..." "pnpm run test" "Tests passed (๑•́ ω •̀๑)" "Tests failed"

echo ""

# Changelog
print_stage "Changelog"
run_check "Generating CHANGELOG.md with git-cliff..." "pnpm run changelog" "Changelog updated" "Changelog generation failed"

echo ""
print_header "Ready to push!  ヾ(•ω•\`)" "$GREEN"
exit 0
