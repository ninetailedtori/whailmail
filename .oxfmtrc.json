{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "sortImports": true,
  "sortTailwindcss": true,
  "sortPackageJson": true,
  "ignorePatterns": ["src/renderer/auto-imports.d.ts", "src/renderer/components.d.ts", "src/renderer/typed-router.d.ts", ".eslintrc-auto-import.json","pnpm-lock.yaml"]
}
