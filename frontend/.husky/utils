### Utilities
#
## Colour Codes
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
RESET='\033[0m'
#
## Formatters
print_header() {
  message="$1"
  colour="$2"
  printf "\n"
  printf "%b━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%b\n" "$colour" "$RESET"
  printf "%b  %s%b\n" "$colour" "$message" "$RESET"
  printf "%b━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%b\n" "$colour" "$RESET"
  printf "\n"
}
#
print_stage() {
  printf "%b=> %s%b\n" "$YELLOW" "$1" "$RESET"
}
#
print_check() {
  printf "  %s\n" "$1"
}
#
print_ok() {
  printf "  %b[OK]%b %s\n" "$GREEN" "$RESET" "$1"
}
#
print_fail() {
  printf "  %b[FAIL]%b %s\n" "$RED" "$RESET" "$1"
}
#
## Tool Checkers
check_command() {
  cmd="$1"
  install_hint="$2"

  if ! command -v "$cmd" >/dev/null 2>&1; then
    print_fail "Required command not found: ${cmd}"
    printf "  %bInstall hint:%b %s\n" "$YELLOW" "$RESET" "$install_hint"
    exit 127
  fi

  print_ok "$cmd found"
}
#
check_all_tools() {
  print_stage "Checking required tools"

  check_command "pnpm" "npm install -g pnpm"
  check_command "cargo" "https://rustup.rs/"
  check_command "git-cliff" "cargo install git-cliff"
  check_command "taplo" "cargo install taplo-cli"
  check_command "yamlfix" "pip install yamlfix"
  check_command "mdformat" "pip install mdformat"

  printf "\n"
}
#
## Runners
run_check() {
  check_msg="$1"
  cmd="$2"
  success_msg="$3"
  fail_msg="$4"

  print_check "$check_msg"
  if eval "$cmd" >/dev/null 2>&1; then
    print_ok "$success_msg"
  else
    print_fail "$fail_msg"
    exit 1
  fi
}
