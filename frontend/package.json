{
  "name": "@whailmail/frontend",
  "version": "0.0.1",
  "description": "The app that makes handling your mail, a whale of a time!",
  "homepage": "https://github.com/whailmail/whailmail",
  "author": "https://github.com/whailmail",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:vue": "vue-tsc --build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@nuxt/ui": "^4.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "@unhead/vue": "^3.4.0",
    "@vueuse/core": "^14.4.0",
    "electron-updater": "^6.8.9",
    "pinia": "^4.0.3",
    "vue": "beta",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@catppuccin/palette": "^1.8.0",
    "@catppuccin/tailwindcss": "^1.0.0",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.81.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.66.0",
    "oxlint": "~1.81.0",
    "sass": "^1.103.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.6.0-beta.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
