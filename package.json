    "@vueuse/core": "^14.3.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "pinia": "^3.0.4",
    "vue": "^3.6.0-beta.10",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
