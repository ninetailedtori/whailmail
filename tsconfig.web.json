{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "frontend/renderer/env.d.ts",
    "frontend/renderer/**/*",
    "frontend/renderer/**/*.vue",
    "frontend/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@resources/*": ["resources/*"],
      "@/*": ["frontend/renderer/*"],
      "@stores/*": ["frontend/renderer/stores/*"],
      "@components/*": ["frontend/renderer/components/*"],
      "@pages/*": ["frontend/renderer/pages/*"],
      "@layouts/*": ["frontend/renderer/layouts/*"],
      "@router/*": ["frontend/renderer/router/*"],
      "@assets/*": ["frontend/renderer/assets/*"],
      "@shared/*": ["frontend/shared/*"]
    }
  },
  "vueCompilerOptions": {
    "plugins": [
      "vue-router/volar/sfc-route-blocks",
      "vue-router/volar/sfc-typed-router"
    ]
  }
}
